# Public Google Maps browser key: restrict by HTTP referrer and Maps/Geocoding APIs.
GOOGLE_MAPS_API_KEY=
# Production website origin, including https, no trailing slash.
SITE_ORIGIN=
PORT=4173
HOST=127.0.0.1
# WhatsApp Cloud API sender: +7 706 406 0101. Get this phone's ID in Meta.
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_API_VERSION=v26.0
# Manager recipient with opt-in. Must be a DIFFERENT number from the API sender.
WA_NOTIFY_TO=
# Approved template with 3 positional BODY parameters: name, phone, destination.
WA_TEMPLATE_NAME=visa_lead
WA_TEMPLATE_LANGUAGE=ru
